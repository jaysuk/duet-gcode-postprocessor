{
	"name": "duet-gcode-postprocessor",
	"version": "1.2.1",
	"description": "G-code post-processor for RepRapFirmware, as a Duet Web Control 3.7 plugin.",
	"private": true,
	"license": "GPL-3.0-or-later",
	"homepage": "https://github.com/jaysuk/duet-gcode-postprocessor",
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "dwc-plugin-typecheck",
